# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/meco_power_uz_db

# Security & Authentication
JWT_SECRET=super-secret-meco-power-uzbekistan-jwt-key
JWT_EXPIRES_IN=7d

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,https://mecopower.uz

# Region Settings
DEFAULT_REGION=Uzbekistan
DEFAULT_CURRENCY=UZS
